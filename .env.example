# Longor — copy to `.env` and fill secrets. Committed as `.env.example` only; never commit real keys.
#
#   cp .env.example .env

# backend system:
# 	maniskill - use maniskill simulation.
# 	xlerobot - use xlerobot real HW (works only from Linux).
BACKEND=maniskill
# ManiSkill environment (only relevant when BACKEND=maniskill).
# Leave unset to auto-select the first available env from the preferred list.
# Common envs: PickCube-v1, PushCube-v1, StackCube-v1, LiftPegUpright-v1
MANISKILL_ENV=PickCube-v1
# Task the agent will perform
ROBOT_TASK="pick the cube"
# Open a live graphical window during the sim run (ManiSkill human render mode).
# Set to 1 to enable; default is 0 (headless rgb_array mode).
DISPLAY_ENV=0
# Renderer / sim backend (passed to gym.make when set). Empty = ManiSkill default.
# Windows: cpu often avoids Vulkan DeviceLost; Linux+NVIDIA: try leaving unset for GPU sim, or keep cpu for debugging.
MANISKILL_RENDER_BACKEND=
MANISKILL_SIM_BACKEND=cpu
ROBOCREW_REQUIRE_RGBD=1
MANISKILL_GYM_MAKE_RETRIES=3
MANISKILL_GYM_MAKE_RETRY_SLEEP=0.35
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
# Model string passed to LLMAgent. Examples:
# 'gpt-4o-mini', 'google_genai:gemini-2.0-flash'
LLM_MODEL=gpt-4o-mini
# Secrets — set in `.env` only (leave empty here in your local file until filled).
OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=   # if using OpenRouter (see core/LLMAgent.py)

# ── VLA HTTP service (run: python services/run_vla_server.py in .vla-venv) ───
# Policy id — must match an entry in services/run_vla_server.py
VLA_POLICY=octo-small-1.5
# Client talks to http://localhost:VLA_PORT
# Port the Octo service listens on.
VLA_PORT=8765
# Max action steps the VLA tool will run before giving up.
VLA_POLICY_MAX_STEPS=30
# Scale factor: raw Octo action → ManiSkill EEF delta (metres).
VLA_ACTION_SCALE=0.05
# EEF→object distance threshold (metres) for proximity-based auto-grasp.
# When dist < this value the VLA loop closes the gripper and returns immediately.
VLA_GRASP_DIST=0.03

# Max absolute magnitude for raw Octo actions; values outside this range are clipped
# before axis remap/scale to avoid wild swings.
VLA_ACTION_CLIP=2.0
# Number of backend substeps per VLA action when calling move_ee/set_gripper. Increasing
# this (e.g. to 2 or 3) gives the PD controller more timesteps to track each command.
VLA_STEPS_PER_ACTION=5
# Absolute gripper magnitude threshold to trigger open/close. Lower this if Octo's
# gripper outputs are typically in the ±0.3 range and actions feel unresponsive.
VLA_GRIPPER_THRESHOLD=0.5
# Confidence threshold for gripper open/close decisions. The raw Octo gripper value
# must exceed this magnitude before a flip is applied.
VLA_GRIPPER_CONFIDENCE=1.5
# Fail fast if camera degrades to placeholder/non-real frames.
VLA_FAIL_ON_PLACEHOLDER=1
# Axis remap/signs: 3 comma-separated indices or +1/-1 for [x,y,z]. Unset = identity / no flip.
# PickCube calibration (tuned for Windows CPU sim); re-tune on Linux/GPU if motion looks wrong:
VLA_AXIS_REMAP=2,0,1
VLA_AXIS_SIGNS=1,-1,-1
# Inner VLA tool budgets.
VLA_MAX_INNER_STEPS=60
VLA_MAX_TOOL_SECONDS=25
# Keep the example single-turn and allow enough wall-clock for one tool call.
ROBOCREW_MAX_LOOPS=1
ROBOCREW_MAX_SECONDS=120
# Where maniskill_pickcube.py saves frames (default: examples/_out if unset).
# ROBOCREW_FRAME_DIR=

# Optional ManiSkill tuning (defaults exist in code; see src/sim/maniskill_backend.py)
# MANISKILL_OBS_MODE=
# MANISKILL_CONTROL_MODE=
# ROBOCREW_SIM_SEED=
# MANISKILL_IK_GAIN=5.0
# MANISKILL_IK_DAMPING=1e-4
# MANISKILL_IK_MAX_JOINT_DELTA=0.25
