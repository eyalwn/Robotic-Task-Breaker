# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
# Model string passed to LLMAgent. Examples:
# 'gpt-4o-mini', 'google_genai:gemini-2.0-flash'
LLM_MODEL=gpt-4.1-mini
# Secrets — set in `.env` only (leave empty here in your local file until filled).
OPENAI_API_KEY=
# ── VLA HTTP service (run: python services/run_vla_server.py in .vla-venv) ───
VLA_POLICY=octo-small-1.5
# Optional axis sign multipliers for raw VLA deltas (dx,dy,dz).
# ManiSkill PickCube: VLA_AXIS_REMAP=2,0,1 and VLA_AXIS_SIGNS=1,-1,-1.
# LIBERO + pi05_libero typically needs VLA_AXIS_SIGNS=1,-1,-1 (y-flip + z-flip; no remap).
# Gripper: delta_sign (ManiSkill/Octo) or absolute_open_close (LIBERO pi05: 0=open, 1=close).
# VLA_GRIPPER_MODE=absolute_open_close
# backend system:
# 	maniskill - use maniskill simulation.
# 	xlerobot - use xlerobot real HW (works only from Linux).
BACKEND=maniskill
# ManiSkill env id for maniskill_rgbd_diag only; examples pass env_id explicitly.
# Common envs: PickCube-v1, PushCube-v1, StackCube-v1, LiftPegUpright-v1
MANISKILL_ENV=PickCube-v1
# Task the agent will perform
ROBOT_TASK="pick the cube"
# Open a live graphical window during the sim run (ManiSkill human render mode).
# Set to 1 to enable; default is 0 (headless rgb_array mode).
DISPLAY_ENV=0
# LIBERO VLA: flip agentview + wrist images 180° before inference (matches OpenPI eval).
# Set to 0 to disable. Default 1 for LIBERO examples.
# LIBERO_VLA_IMAGE_FLIP=1
