# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
# Model string passed to LLMAgent. Examples:
# 'gpt-4o-mini', 'google_genai:gemini-2.0-flash'
LLM_MODEL=gpt-5.4-mini
# Secrets — set in `.env` only (leave empty here in your local file until filled).
OPENAI_API_KEY=
# ── VLA HTTP service (run: python services/run_vla_server.py in .vla-venv) ───
VLA_POLICY=octo-small-1.5
# backend system:
# 	maniskill - use maniskill simulation.
# 	xlerobot - use xlerobot real HW (works only from Linux).
BACKEND=maniskill
# ManiSkill environment (only relevant when BACKEND=maniskill).
# Leave unset to auto-select the first available env from the preferred list.
# Common envs: PickCube-v1, PushCube-v1, StackCube-v1, LiftPegUpright-v1
MANISKILL_ENV=PickCube-v1
# Task the agent will perform
ROBOT_TASK="pick the cube"
# Open a live graphical window during the sim run (ManiSkill human render mode).
# Set to 1 to enable; default is 0 (headless rgb_array mode).
DISPLAY_ENV=0
