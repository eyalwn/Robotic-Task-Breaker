# Copy to .env (gitignored) and fill in.
# Required key plus optional runtime overrides read from src/config.py.

# Secret, read by the LLM SDK.
OPENAI_API_KEY=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Model used by both the planner and the feedback evaluator.
LLM_MODEL=gpt-4.1-mini

# 1 to record the run to run.mp4 (the policy's view of the scene).
SAVE_VIDEO=0

# Optional overrides (uncomment to use).
# VLA_POLICY=groot  # groot | pi0fast | smolvla
# VLA_TIMEOUT=60
# VIDEO_PATH=run.mp4
# VIDEO_FPS=10
# VLA_ACTIONS_PER_CHUNK=5
# MAX_SKILL_STEPS={"transfer": 250, "open_drawer": 720}
# MAX_PLAN_RETRIES=3
