# Copy to .env (gitignored) and fill in. These four are the only environment
# variables Longor reads; every other tunable is a constant in src/config.py.

# Secret, read by the LLM SDK.
OPENAI_API_KEY=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Model used by both the planner and the feedback evaluator.
LLM_MODEL=gpt-4.1-mini

# 1 to record the run to run.mp4 (the policy's view of the scene).
SAVE_VIDEO=0
